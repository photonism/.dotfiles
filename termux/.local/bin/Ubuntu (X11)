#!/data/data/com.termux/files/usr/bin/bash

# Kill open X11 processes
kill -9 $(pgrep -f "termux.x11") 2>/dev/null

# Start PulseAudio
~/.local/share/init.d/pulseaudio restart

# Prepare termux-x11 session
export XDG_RUNTIME_DIR=${TMPDIR}
termux-x11 :0 >/dev/null &

# Wait a bit until termux-x11 gets started.
sleep 3

# Launch Termux X11 main activity
am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity > /dev/null 2>&1
sleep 1

# Login in PRoot Environment and lock PULSE_SERVER to the custom high port
proot-distro login ubuntu --shared-tmp -- /bin/bash -c 'su - nora -c "env DISPLAY=:0 PULSE_SERVER=tcp:127.0.0.1:47113 startxfce4"'

exit 0
