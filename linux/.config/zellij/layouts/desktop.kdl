layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                format_left   "{tabs}"
                format_right  " #[fg=8]{mode}  {session} "
                format_space  ""

                tab_normal   " #[fg=8]{name} "
                tab_active   " #[fg=0,bold]{name} "

                mode_normal       "NORMAL"
                mode_locked       "LOCKED"
                mode_pane         "PANE"
                mode_tab          "TAB"
                mode_resize       "RESIZE"
                mode_scroll       "SCROLL"
                mode_search       "SEARCH"
                mode_session      "SESSION"
                mode_move         "MOVE"
                mode_enter_search "ENTER-SEARCH"
                mode_rename_tab   "RENAME-TAB"
                mode_rename_pane  "RENAME-PANE"
                mode_prompt       "PROMPT"
                mode_tmux         "TMUX"
            }
        }

        children
    }
}
